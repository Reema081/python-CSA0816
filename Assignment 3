        },
        {
            "name": "Arun",
            "phones": ["9876543210"],
            "emails": []
        },
        {
            "name": "Arun Kumar",
            "phones": [],
            "emails": ["arun@gmail.com"]
        }
    ]

    print("CONTACT MERGING RESULT")

    result = merge_contacts(contacts)

    for person in result:
        print("\nNames:", person["names"])
        print("Phone numbers:", person["phones"])
        print("Emails:", person["emails"])

    print("\nPERFORMANCE TEST")

    for n in [1000, 100000]:
        data = generate_contacts(n)

        start = time.perf_counter()
        merged = merge_contacts(data)
        end = time.perf_counter()

        print("\nInput contacts:", n)
        print("Merged contacts:", len(merged))
        print("Dictionary time:", round(end - start, 6), "seconds")

        comparisons = n * (n - 1) // 2
        print("Pairwise comparisons required:", comparisons)

        if n == 1000:
            start = time.perf_counter()
            pairwise_comparison(n)
            end = time.perf_counter()

            print("Pairwise time:",
                  round(end - start, 6), "seconds")
        else:
            print("Pairwise time: Not executed (too many comparisons)")


if __name__ == "__main__":
    main()

